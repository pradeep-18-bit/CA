# Backend API Base URL (Docker internal networking)
REACT_APP_API_URL=http://backend:5000

# App Configuration
REACT_APP_APP_NAME=MyApp
REACT_APP_ENV=production

# Optional: If you want to use Public EC2 IP instead (for browser direct call)
# Uncomment and replace with your EC2 IP
# REACT_APP_API_URL=http://<EC2-PUBLIC-IP>:5000
